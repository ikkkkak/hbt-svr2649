LOCATION_TOKEN=
DB_CONNECTION_STRING=host= user= password= dbname= port= sslmode=
EMAIL_TOKEN_SECRET=
# Gmail SMTP (Google Account → Security → 2-Step Verification → App passwords)
EMAIL_FROM=dhminekhalil@gmail.com
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Meskeny
# Admin inbox for new listing alerts (property sale, rent, land)
ADMIN_NOTIFY_EMAIL=
# Media CDN: google | cloudinary | aws | digitalocean  (alias: CDN_PROVIDER)
# MEDIA_CDN=digitalocean

# --- Google Cloud Storage (MEDIA_CDN=google) ---
# GCS_BUCKET_NAME=
# GCS_FOLDER=
# GCS_PUBLIC_BASE_URL=

# --- Cloudinary (MEDIA_CDN=cloudinary) ---
# Option A: single URL (cloudinary://API_KEY:API_SECRET@CLOUD_NAME)
# CLOUDINARY_URL=
# Option B: separate vars (API key must allow upload/create in Cloudinary console)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=
# Optional unsigned fallback (preset must exist on the same cloud):
# CLOUDINARY_UPLOAD_PRESET=unsigned-preset
# CLOUDINARY_UPLOAD_MODE=signed|unsigned  (default: signed, then unsigned if preset set)

# --- AWS S3 (MEDIA_CDN=aws) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=
# AWS_S3_PUBLIC_BASE_URL=
# Optional custom S3 API endpoint (MinIO, etc.):
# AWS_S3_ENDPOINT=

# --- DigitalOcean Spaces (MEDIA_CDN=digitalocean) ---
# Create keys: DO Control Panel → API → Spaces access keys
# DO_SPACES_ACCESS_KEY_ID=
# DO_SPACES_SECRET_ACCESS_KEY=
# DO_SPACES_BUCKET=meskney-iv
# DO_SPACES_REGION=sfo3
# DO_SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
# Public origin / CDN URL served to the app (your bucket subdomain):
# DO_SPACES_CDN_URL=https://meskney-iv.sfo3.cdn.digitaloceanspaces.com
# DO_SPACES_PUBLIC_BASE_URL=https://meskney-iv.sfo3.cdn.digitaloceanspaces.com
# Optional: set to private to skip public-read ACL on upload
# DO_SPACES_OBJECT_ACL=public-read
# Aliases also accepted: DO_SPACES_KEY, DO_SPACES_SECRET, DO_SPACES_CDN_URL, DO_SPACES_ORIGIN_URL
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
# Optional: access token lifetime in minutes (default 15). e.g. 60=1h, 10080=7d
# ACCESS_TOKEN_EXPIRY_MINUTES=15

# Firebase Cloud Messaging — *service account* JSON (Firebase Console → Project settings →
# Service accounts → Generate new private key). Never use google-services.json here (Android-only).
# Option A — file path (cwd = server root): FCM_CREDENTIALS_PATH=./service-account.json
# Option B — inline JSON on deploy: FCM_CREDENTIALS_JSON={"type":"service_account",...}
# If unset, startup scans ./service-account.json, ./fcm-credentials.json, then any *.json in
# this folder containing "type":"service_account" (e.g. dhmine-khalil-c662b4932817.json).